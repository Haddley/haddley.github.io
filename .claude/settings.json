{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" pull --ff-only 2>&1 || true",
            "timeout": 60,
            "statusMessage": "Pulling the latest changes from GitHub"
          }
        ]
      }
    ]
  }
}
